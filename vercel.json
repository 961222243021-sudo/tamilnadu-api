{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/normalized/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:route*",
      "destination": "/api/index?route=:route*"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    },
    {
      "source": "/read/:year/:seat",
      "destination": "/read.html"
    },
    {
      "source": "/playground",
      "destination": "/playground.html"
    }
  ]
}
