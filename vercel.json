{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/normalized/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index?route=:path*" },
    { "source": "/docs", "destination": "/index.html" }
  ]
}
